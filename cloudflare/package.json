{
  "name": "squish-pocket-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.test.jsonc --port 4173",
    "test": "node --test tests/*.test.js",
    "db:local": "wrangler d1 migrations apply ACHIEVEMENTS --local --config wrangler.test.jsonc",
    "deploy": "node scripts/release.mjs test",
    "test:rooms": "vitest run",
    "deploy:test": "node scripts/release.mjs test",
    "deploy:production": "node scripts/release.mjs production",
    "check:release": "node scripts/release.mjs status",
    "verify:test": "node scripts/release.mjs verify-test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
