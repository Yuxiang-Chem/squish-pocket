{
  "name": "squish-pocket-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 4173",
    "test": "node --test tests/*.test.js",
    "db:local": "wrangler d1 migrations apply ACHIEVEMENTS --local",
    "db:test": "wrangler d1 migrations apply ACHIEVEMENTS --remote --env test",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:test": "wrangler deploy --env test",
    "test:rooms": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
